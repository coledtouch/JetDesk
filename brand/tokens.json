{
  "brand": "JetDesk.AI",
  "direction": "Midnight + Ion",
  "tagline": "Know what the trip costs before you file.",
  "domain": "https://www.jetdesk.ai",
  "color": {
    "dark": {
      "bg": "#070B14",
      "card": "#0B1220",
      "card2": "#121C2E",
      "line": "#1E2A40",
      "line2": "#2A3A55",
      "ink": "#E6EAF2",
      "ink2": "#A7B2C3",
      "ink3": "#6B7A90",
      "acc": "#4CC9FF",
      "acc-soft": "#0E2536",
      "acc2": "#7CC4FF",
      "good": "#2FD27D",
      "good-soft": "#0F2A1E",
      "warn": "#FFB020",
      "warn-soft": "#2B2110",
      "bad": "#FF5A5F",
      "bad-soft": "#2B1416",
      "btn": "#4CC9FF",
      "btn-ink": "#06131F"
    },
    "light": {
      "bg": "#F4F6FA",
      "card": "#FFFFFF",
      "card2": "#EEF2F7",
      "line": "#DCE3EC",
      "line2": "#C5CFDB",
      "ink": "#0F172A",
      "ink2": "#475569",
      "ink3": "#6B7A90",
      "acc": "#0E7CFF",
      "acc-soft": "#E3F0FF",
      "acc2": "#0B5FCC",
      "acc2-soft": "#E3F0FF",
      "good": "#0E9F5B",
      "good-soft": "#E1F5EA",
      "warn": "#B7791F",
      "warn-soft": "#FFF3D6",
      "bad": "#D93A3F",
      "bad-soft": "#FCE4E5",
      "btn": "#0F172A",
      "btn-ink": "#F4F6FA"
    },
    "names": {
      "#070B14": "Midnight",
      "#0B1220": "Cabin",
      "#121C2E": "Cabin 2",
      "#4CC9FF": "Ion (dark mode accent)",
      "#0E7CFF": "Ion (light mode accent)",
      "#E6EAF2": "Instrument white",
      "#2FD27D": "Go green",
      "#FFB020": "Caution amber",
      "#FF5A5F": "Stop red"
    }
  },
  "type": {
    "wordmark": { "family": "Michroma", "weights": [400], "use": "wordmark, eyebrows, verdict words; always uppercase with tracking .08em to .2em" },
    "display": { "family": "Manrope", "weights": [800], "use": "headlines; tight tracking -0.03em, line-height 1.02" },
    "body": { "family": "Manrope", "weights": [400, 500, 600, 700], "use": "all reading text" },
    "mono": { "family": "B612 Mono", "weights": [400, 700], "use": "every number: dollars, gallons, knots, feet, minutes, METAR raw text" },
    "fallbacks": {
      "Michroma": "'Arial Black', sans-serif",
      "Manrope": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "B612 Mono": "ui-monospace, Menlo, Consolas, monospace"
    }
  },
  "radius": { "chip": 999, "field": 9, "button": 10, "cardSmall": 12, "card": 16, "hero": 20, "phoneFrame": 36, "sheet": 18, "appIconTile": 18 },
  "shadow": {
    "phone": "0 30px 70px rgba(0,0,0,.35), 0 0 0 1px color-mix(in srgb, var(--acc) 20%, transparent)"
  },
  "logo": {
    "viewBox": "0 0 72 72",
    "markPath": "M14 46 L36 14 L58 46 L48 46 L36 28 L24 46 Z",
    "contrail1": { "d": "M22 54 H50", "strokeWidth": 4, "opacity": 0.55 },
    "contrail2": { "d": "M30 60 H42", "strokeWidth": 4, "opacity": 0.3 },
    "tile": { "x": 2, "y": 2, "w": 68, "h": 68, "rx": 18, "fill": "#0B1220", "stroke": "#1E2A40" },
    "markColor": "#4CC9FF",
    "clearSpace": "the height of the contrail gap (8 units on the 72 grid) on every side",
    "minimumSize": "20px for the mark alone, 96px wide for the lockup"
  },
  "pwa": {
    "themeColorLight": "#F4F6FA",
    "themeColorDark": "#070B14",
    "manifestBackground": "#070B14",
    "icons": ["192 any", "512 any", "192 maskable", "512 maskable", "180 apple-touch"]
  }
}
